# Copy to .env and fill in. .env is gitignored.

# APIMart: the main provider for video, images and the vision judge (usually the cheapest). https://apimart.ai/keys
APIMART_API_KEY=

# Kie.ai: the second provider (music, voices, file hosting, and any model APIMart doesn't sell or sells for more).
# https://kie.ai/api-key . The engine compares both live prices and sends each job to the cheaper one.
KIE_API_TOKEN=

# ElevenLabs: TTS, speech-to-speech and sound effects. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: review board port (default 4317)
# BOARD_PORT=4317
